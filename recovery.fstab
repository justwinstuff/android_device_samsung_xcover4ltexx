/dev/block/platform/13540000.dwmmc0/by-name/SYSTEM    /system        ext4    ro    wait
/dev/block/platform/13540000.dwmmc0/by-name/SYSTEM    /system_image  emmc    defaults    wait

/dev/block/platform/13540000.dwmmc0/by-name/CACHE     /cache         ext4    rw    wait
/dev/block/platform/13540000.dwmmc0/by-name/USERDATA  /data          ext4    rw    wait,length=-16384

/dev/block/platform/13540000.dwmmc0/by-name/BOOT      /boot          emmc    defaults    wait
/dev/block/platform/13540000.dwmmc0/by-name/RECOVERY  /recovery      emmc    defaults    wait

/dev/block/platform/13540000.dwmmc0/by-name/OTA       /misc          emmc    defaults    wait
/dev/block/platform/13540000.dwmmc0/by-name/EFS       /efs           ext4    rw    wait
/dev/block/platform/13540000.dwmmc0/by-name/RADIO     /radio         emmc    defaults    wait

/dev/block/mmcblk1p1    /external_sd   vfat    defaults    voldmanaged=sdcard:auto
/dev/block/sda1         /usb-otg       vfat    defaults    voldmanaged=usb:auto